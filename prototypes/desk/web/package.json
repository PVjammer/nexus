{
  "name": "nexus-desk-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/app.js --loader:.css=css",
    "watch": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/app.js --loader:.css=css --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "dompurify": "3.2.3",
    "esbuild": "0.24.2",
    "marked": "14.1.4",
    "typescript": "5.6.3"
  }
}
